-- Создание базы данных (если нужно)
CREATE DATABASE BookstoreDB;
GO

USE BookstoreDB;
GO

-- 1. Таблица Пользователь (заполняется вами)
CREATE TABLE Пользователь (
    id INT PRIMARY KEY,
    id_роли INT,
    ФИО NVARCHAR(255),
    Логин NVARCHAR(255),
    Пароль NVARCHAR(255)
);
GO

-- 2. Таблица Роли (заполняется вами)
CREATE TABLE Роли (
    id_роли INT PRIMARY KEY,
    НазваниеРоли NVARCHAR(100)
);
GO

-- 3. Таблица Поставщик (заполняется вами)
CREATE TABLE Поставщик (
    id_поставщика INT PRIMARY KEY,
    Поставщик NVARCHAR(255)
);
GO

-- 4. Таблица ПунктВыдачи
CREATE TABLE ПунктВыдачи (
    id INT PRIMARY KEY,
    Адрес NVARCHAR(255)
);
GO

-- 5. Таблица Товар
CREATE TABLE Товар (
    id_товара INT PRIMARY KEY,
    Артикул NVARCHAR(50),
    НаименованиеТовара NVARCHAR(255),
    ЕдиницаИзмерения NVARCHAR(20),
    Цена DECIMAL(10,2),
    id_поставщика INT,
    Производитель NVARCHAR(255),
    Категория_товара NVARCHAR(100),
    ДействующаяСкидка INT,
    Кол_во_на_складе INT,
    ОписаниеТовара NVARCHAR(MAX),
    Фото NVARCHAR(100)
);
GO

-- 6. Таблица Заказ (связи с другими таблицами)
CREATE TABLE Заказ (
    id_заказа INT PRIMARY KEY,
    количество INT,
    id_товара INT,
    ДатаЗаказа DATE,
    ДатаДоставки DATE,
    id_пункта INT,
    id_пользователя INT,
    КодДляПолучения NVARCHAR(50),
    СтатусЗаказа NVARCHAR(50),
    FOREIGN KEY (id_товара) REFERENCES Товар(id_товара),
    FOREIGN KEY (id_пункта) REFERENCES ПунктВыдачи(id),
    FOREIGN KEY (id_пользователя) REFERENCES Пользователь(id)
);
GO


